# IRIS / PAIMANA Backend Configuration Template
# Copy to .env and adjust variables for your local or cloud environment

PROJECT_NAME="PAIMANA / IRIS API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Connection (PostgreSQL)
# Local development:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/paimana_db"
# Production Neon example:
# DATABASE_URL="postgresql+psycopg2://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/iris_db?sslmode=require"
# SQLite fallback (if needed):
# DATABASE_URL="sqlite:///data/serving/paimana_dev.sqlite3"

# Serving Artifact Directory (relative to repo root or absolute path)
SERVING_DIR="data/serving"

# CORS Configuration
# Set FRONTEND_ORIGIN to your Vercel deployment URL (e.g. https://iris-app.vercel.app)
FRONTEND_ORIGIN=

# Additional allowed origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
