# IRIS / PAIMANA Backend Configuration Template
# Copy to .env and adjust variables for your local environment

PROJECT_NAME="PAIMANA / IRIS API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Connection (PostgreSQL)
# Standard local development PostgreSQL connection string
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/paimana_db"

# For isolated testing or SQLite fallback (if needed):
# Serving Artifact Directory (relative to repo root or absolute path)
SERVING_DIR="data/serving"

# CORS Configuration

# Comma-separated list or JSON array of allowed origins for frontend applications
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
