      "project_name",
      "actual_completion_date"
    ]
  },
  "embargo": {
    "rule": "strict_walk_forward",
    "formula": "T + 3 < E (i.e. month_index(add_months(T, 3)) < month_index(E))",
    "horizon_months": 3,
    "description": "For evaluation reference month E, training observation T is usable only when the forward prediction window strictly ends before E."
  },
  "continuous_segments": [
