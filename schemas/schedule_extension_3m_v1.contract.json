{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dataset_name": "schedule_extension_3m_v1",
  "contract_version": "1.0.0",
  "dataset_type": "schedule_extension_prediction",
  "description": "Authoritative frozen ML data contract for IRIS 3-month schedule-extension prediction pipeline.",
  "target": {
    "name": "target_effective_schedule_ext_3m",
    "horizon_months": 3,
    "description": "Effective schedule push-out over forward H=3 months window within continuous segment.",
    "baseline_definition": "revised_completion_date(T) if actually reported, otherwise original_completion_date(T)",
    "positive_rule": "At least one actually reported revised_completion_date in T+1..T+3 is later than the usable baseline at T.",
    "negative_rule": "Complete same-segment T+1..T+3 observations, no reported extension, and no unresolved revised-value null after a revision has appeared.",
    "ambiguity_rule": "A null never resets a previously reported revision to the original commitment. Such baseline/window ambiguity is ineligible unless a reported future extension already proves a positive.",
    "extension_types": {
      "FIRST_REVISION": "No revised completion date reported at T; first revision appears in forward window.",
      "SUBSEQUENT_REVISION": "Revised completion date already present at T; later revised completion date appears in forward window.",
      "NONE": "No extension observed in forward window (negative)."
    }
  },
  "features": {
    "count": 36,
    "ordered_names": [
      "sector",
      "agency",
      "state",
      "original_cost",
      "cumulative_expenditure_t",
      "revised_cost_t",
      "physical_progress_t",
      "project_age_months",
      "months_to_original_schedule",
      "months_to_effective_schedule",
      "schedule_revision_lag_months",
      "schedule_has_been_revised",
      "months_since_start",
      "expenditure_to_original_cost_ratio",
      "revised_to_original_cost_ratio",
      "cost_has_been_revised",
      "exp_delta_1m",
      "exp_delta_3m",
      "past_exp_stagnant_3m",
      "past_progress_delta_3m",
      "past_progress_stagnant_3m",
      "n_prior_schedule_extensions",
      "n_prior_cost_revisions",
      "observed_tenure_months",
      "state_is_missing",
      "approval_date_is_missing",
      "original_completion_date_is_missing",
      "revised_cost_is_present",
      "revised_date_is_present",
      "physical_progress_is_present",
      "physical_progress_supported",
      "start_date_is_present",
      "start_date_supported",
      "exp_delta_1m_is_supported",
      "exp_delta_3m_is_supported",
      "progress_delta_3m_is_supported"
    ],
    "families": {
      "static_categoricals": [
        "sector",
        "agency",
        "state"
      ],
      "static_cost_financial": [
        "original_cost",
        "revised_cost_t",
        "cumulative_expenditure_t",
        "expenditure_to_original_cost_ratio",
        "revised_to_original_cost_ratio",
