      "outcome_field": "physical_progress(T+3)",
      "viability": "NOT_YET_VIABLE",
      "primary_bottlenecks": [
        "severe_class_rarity_2.3_percent_prevalence",
        "insufficient_temporal_positives_for_walk_forward_folds"
      ]
    },
    "candidate_4_expenditure_stagnation": {
      "name": "target_expenditure_stagnation_3m",
      "scope": "projects_monthly.csv (All Segments, N=40,456 complete windows)",
      "baseline_field": "cumulative_expenditure(T)",
      "outcome_field": "cumulative_expenditure(T+3)",
      "viability": "VIABLE_WITH_LIMITATIONS",
      "primary_bottlenecks": [
        "financial_disbursement_cycle_proxy_rather_than_implementation",
        "known_mospi_anomalies_expenditure_with_zero_progress"
      ]
    },
    "candidate_5_lifecycle_completed_implementation": {
      "name": "target_completed_implementation_overrun",
      "scope": "projects_completed.csv (N=876)",
      "viability": "NOT_YET_VIABLE",
      "primary_bottlenecks": [
        "extreme_right_censoring_81.5_pct_ongoing_projects",
        "physical_progress_column_absent_in_completed_dataset",
        "survivorship_bias_only_completed_projects_observed"
      ]
    }
  },
