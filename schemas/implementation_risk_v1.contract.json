{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_name": "implementation_risk_v1",
  "dataset_name": "implementation_risk_v1",
  "contract_version": "1.0.0",
  "dataset_type": "implementation_risk_prediction",
  "description": "Authoritative frozen ML data contract and target definition for IRIS 3-month implementation-risk / physical-progress stagnation prediction pipeline.",
  "target": {
    "name": "target_progress_stagnation_3m",
    "horizon_months": 3,
    "tolerance_percentage": 0.000001,
    "description": "Observable physical progress stagnation or deterioration over forward H=3 months window within continuous segment for an actively ongoing project.",
    "baseline_definition": "Reported physical_progress at prediction origin T satisfying 0.0 <= physical_progress < 100.0.",
    "positive_rule": "physical_progress(T+3) - physical_progress(T) <= 1e-6 (physical works failed to advance, progress stalled at zero delta, or progress was revised downward over 3 months).",
    "negative_rule": "physical_progress(T+3) - physical_progress(T) > 1e-6 with complete same-segment T+1..T+3 reported physical progress values.",
    "ambiguity_rules": {
      "LAYOUT_PROGRESS_UNSUPPORTED": "Report months in Segments 1 and 2 where the MoSPI Flash Report layout structurally omitted physical progress percentage.",
      "MISSING_BASELINE_PROGRESS": "physical_progress at prediction origin T is null or unreported.",
      "BASELINE_ALREADY_COMPLETED": "physical_progress at prediction origin T >= 100.0 (project is already completed on the ground; lack of further advance is expected completion, not stagnation).",
      "FUTURE_PROGRESS_MISSING": "Project is continuously observed in T+1..T+3, but physical_progress is null/missing in one or more forward window months."
    },
    "progress_subtypes": {
      "ZERO_ADVANCE": "Delta physical progress == 0.0 (physical works completely flat over 3 months).",
      "DETERIORATION": "Delta physical progress < 0.0 (administrative downward revision of physical progress).",
      "ADVANCE": "Delta physical progress > 0.0 (positive physical advancement on the ground; negative label)."
    }
  },
  "audited_candidates": {
    "candidate_1_rolling_progress_stagnation": {
      "name": "target_progress_stagnation_3m",
      "scope": "projects_monthly.csv (Segments 3 & 4, N=26,044 eligible)",
      "baseline_field": "physical_progress(T)",
      "outcome_field": "physical_progress(T+3)",
      "viability": "VIABLE_WITH_LIMITATIONS",
      "primary_bottlenecks": [
        "structural_omission_segments_1_and_2",
        "segment_and_regime_boundary_censoring",
        "administrative_self_reporting_proxy"
      ]
    },
    "candidate_2_dual_stagnation": {
      "name": "target_dual_stagnation_3m",
      "scope": "projects_monthly.csv (Segments 3 & 4, N=26,044 eligible)",
      "baseline_field": "physical_progress(T) and cumulative_expenditure(T)",
      "outcome_field": "physical_progress(T+3) and cumulative_expenditure(T+3)",
      "viability": "VIABLE_WITH_LIMITATIONS",
      "primary_bottlenecks": [
        "structural_omission_segments_1_and_2",
        "narrower_event_definition_misses_unproductive_expenditure"
      ]
    },
    "candidate_3_progress_deterioration": {
      "name": "target_progress_deterioration_3m",
      "scope": "projects_monthly.csv (Segments 3 & 4)",
