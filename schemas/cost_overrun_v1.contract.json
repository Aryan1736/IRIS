{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dataset_name": "cost_overrun_v1",
  "contract_version": "1.0.0",
  "dataset_type": "cost_overrun_prediction",
  "description": "Authoritative frozen ML data contract and target definition for IRIS 3-month cost-overrun / cost-escalation prediction pipeline.",
  "target": {
    "name": "target_effective_cost_esc_3m",
    "horizon_months": 3,
    "tolerance_cr": 0.001,
    "description": "Effective administrative upward cost revision / escalation over forward H=3 months window within continuous segment.",
    "baseline_definition": "revised_cost(T) if actually reported and > 0, otherwise original_cost(T)",
    "positive_rule": "At least one actually reported revised_cost in T+1..T+3 is strictly greater than the usable baseline at T (by > 0.001 Rs crore).",
    "negative_rule": "Complete same-segment T+1..T+3 observations, no reported cost escalation, and no unresolved revised-cost null after a revision has appeared.",
    "ambiguity_rule": "A null never resets a previously reported cost revision to the original sanctioned cost. Such baseline/window ambiguity is ineligible unless a reported future extension already proves a positive.",
    "revision_types": {
      "FIRST_COST_REVISION": "No revised cost reported at T; first revised cost appears in forward window exceeding original cost.",
      "SUBSEQUENT_COST_REVISION": "Revised cost already present at T; higher revised cost appears in forward window.",
      "NONE": "No cost escalation observed in forward window (negative)."
    }
  },
  "audited_candidates": {
    "candidate_a_lifecycle_completed": {
      "name": "target_completed_cost_overrun_v1",
      "scope": "projects_completed.csv (N=876)",
      "baseline_field": "original_cost",
      "outcome_field": "revised_cost / cumulative_expenditure",
      "viability": "NOT_YET_VIABLE",
      "primary_bottlenecks": [
        "extreme_right_censoring_81.5_pct_ongoing_projects",
        "outcome_missingness_80.6_pct_completed_revised_cost_null",
        "survivorship_bias_only_completed_projects_observed",
        "sector_concentration_over_50_pct_road_transport",
        "temporal_clustering_june_2026_and_oct_2024"
      ]
    },
    "candidate_b_rolling_escalation": {
      "name": "target_effective_cost_esc_3m",
      "scope": "projects_monthly.csv (N=64608)",
      "baseline_field": "effective_cost(T)",
      "outcome_field": "revised_cost(t) for t in T+1..T+3",
      "viability": "VIABLE_WITH_LIMITATIONS",
      "primary_bottlenecks": [
        "severe_class_imbalance_1_to_44.9",
        "boundary_and_exit_censoring_24152_rows",
        "administrative_reporting_proxy_rather_than_final_audit"
      ]
    },
    "candidate_c_lifecycle_cost_growth": {
      "name": "target_lifecycle_cost_growth_threshold",
